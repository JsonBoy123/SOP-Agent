# Frontend Environment Variables - EXAMPLE
# Copy this file to .env and fill in your actual values

# ========================================
# API Configuration
# ========================================
# Backend API base URL
# Local development: http://localhost:5000/api/v1
# Production: https://api.your-domain.com/api/v1
REACT_APP_API_BASE_URL=http://localhost:5000/api/v1

# Frontend application URL (for reference)
# Local development: http://localhost:3000
# Production: https://your-domain.com
REACT_APP_FRONTEND_URL=http://localhost:3000

# ========================================
# Optional Configuration
# ========================================
# You can add more config here as needed:

# Enable debug mode (shows extra console logs)
# REACT_APP_DEBUG=false

# Chat history storage location
# REACT_APP_STORAGE_KEY=opsmind_chat_history

# Maximum messages to keep in chat history
# REACT_APP_MAX_CHAT_HISTORY=50

# Streaming timeout in milliseconds
# REACT_APP_STREAM_TIMEOUT=60000
