# Backend Environment Variables - EXAMPLE
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ========================================
# MongoDB Configuration
# ========================================
# Get this from MongoDB Atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
# Make sure to:
# 1. Replace "username" with your MongoDB user
# 2. Replace "password" with your MongoDB password (URL-encode special chars)
# 3. Replace "cluster" with your actual cluster name
# 4. Add your IP to whitelist in MongoDB Atlas
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/opsmind_db?retryWrites=true&w=majority

# ========================================
# Google Gemini API Configuration
# ========================================
# Get this from https://ai.google.dev/
# 1. Sign in with your Google account
# 2. Click "Get API Key"
# 3. Create new API key
# 4. Copy the entire key (including "AIza..." prefix)
GEMINI_API_KEY=AIzaSyBH85-24Ev7L61g0OYu4KQTak6U38QhK7c

# ========================================
# Server Configuration
# ========================================
# Port number where Express server listens
# Default: 5000 (change if port 5000 is already in use)
PORT=5000

# Node environment (development/production)
# Use 'development' for local testing
NODE_ENV=development

# ========================================
# Frontend Configuration
# ========================================
# Frontend URL for CORS (must match exactly where frontend is running)
# Local development: http://localhost:3000
# Production: https://your-domain.com
FRONTEND_URL=http://localhost:3000

# ========================================
# File Upload Configuration
# ========================================
# Maximum file size in bytes
# Default: 50000000 (50 MB)
# Increase if you need to support larger PDFs
MAX_FILE_SIZE=50000000

# Directory where uploaded PDFs will be stored
# Relative or absolute path
# Will be created automatically if doesn't exist
UPLOAD_DIR=./uploads

# ========================================
# Advanced Configuration (Optional)
# ========================================
# You can add more config here as needed:

# Log level: error, warn, info, debug
# LOG_LEVEL=info

# Database name (if you want to customize)
# DB_NAME=opsmind_db

# Enable detailed request logging
# VERBOSE_LOGGING=true
